 .../crates/ag1-core/tests/tool_contract.rs    |  25 ++++
 2 files changed, 137 insertions(+), 14 deletions(-)

diff --git a/product/crates/ag1-core/src/tools/shell.rs b/product/crates/ag1-core/src/tools/shell.rs
index d6fef8e..9e74844 100644
--- a/product/crates/ag1-core/src/tools/shell.rs
+++ b/product/crates/ag1-core/src/tools/shell.rs
@@ -78,32 +78,130 @@ pub fn guard(command: &str, job: bool) -> Result<(), DomainError> {
         .or_else(|| (!job).then(|| install_guard(command)).flatten());
     reason.map_or(Ok(()), |reason| Err(DomainError::InvalidInput(reason)))
 }
+/// Literal outer-shell destinations for advisory post-command file hints.
+/// This is not an exhaustive effect tracker: do not interpret quoted programs,
+/// substitutions or here-document bodies as commands of the outer shell.
 pub fn write_targets(command: &str) -> Vec<String> {
-    static TARGET: LazyLock<Regex> = LazyLock::new(|| re(r"(>>|>)\s*([^\s;&|<>]+)"));
+    let bytes = command.as_bytes();
     let mut targets = vec![];
-    for capture in TARGET.captures_iter(command) {
-        let operator = capture.get(1).unwrap();
-        if operator.as_str() == ">"
-            && operator.start() > 0
-            && command.as_bytes()[operator.start() - 1].is_ascii_digit()
+    let (mut at, mut quote, mut here_document) = (0, None, false);
+    while at < bytes.len() {
+        let byte = bytes[at];
+        if quote == Some(b'\'') {
+            if byte == b'\'' {
+                quote = None;
+            }
+            at += 1;
+            continue;
+        }
+        if byte == b'\\' {
+            at = (at + 2).min(bytes.len());
+            continue;
+        }
+        if let Some(delimiter) = quote {
+            if byte == delimiter {
+                quote = None;
+            }
+            at += 1;
+            continue;
+        }
+        if matches!(byte, b'\'' | b'"' | b'`') {
+            quote = Some(byte);
+            at += 1;
+            continue;
+        }
+        if here_document && byte == b'\n' {
+            break;
+        }
+        if byte == b'#'
+            && (at == 0 || bytes[at - 1].is_ascii_whitespace() || b";|&()".contains(&bytes[at - 1]))
         {
+            while at < bytes.len() && bytes[at] != b'\n' {
+                at += 1;
+            }
             continue;
         }
-        if operator.as_str() == ">"
-            && operator.start() > 0
-            && command.as_bytes()[operator.start() - 1] == b'&'
+        // These constructs need a shell grammar to distinguish comparisons and
+        // nested programs from redirects. Omitting an advisory hint is safer
+        // than inventing a destination. Nothing here authorizes execution.
+        if bytes[at..].starts_with(b"$(")
+            || bytes[at..].starts_with(b"((")
+            || bytes[at..].starts_with(b"[[")
         {
+            break;
+        }
+        if bytes[at..].starts_with(b"<<") {
+            here_document = true;
+        }
+        if byte != b'>' {
+            at += 1;
+            continue;
+        }
+        let append = bytes.get(at + 1) == Some(&b'>');
+        let prefixed = at > 0 && (bytes[at - 1].is_ascii_digit() || bytes[at - 1] == b'&');
+        at += if append { 2 } else { 1 };
+        let (target, end) = literal_redirect_target(bytes, at);
+        at = end;
+        // Preserve the existing descriptor-redirection scope of these hints.
+        if !append && prefixed {
             continue;
         }
-        let target = capture[2]
-            .trim_start_matches(['\'', '"'])
-            .trim_end_matches(['\'', '"']);
-        if !target.is_empty() && target != "/dev/null" && !targets.iter().any(|s| s == target) {
-            targets.push(target.into());
+        if let Some(target) = target
+            && target != "/dev/null"
+            && !targets.contains(&target)
+        {
+            targets.push(target);
         }
     }
     targets
 }
+
+fn literal_redirect_target(bytes: &[u8], mut at: usize) -> (Option<String>, usize) {
+    while bytes.get(at).is_some_and(u8::is_ascii_whitespace) {
+        at += 1;
+    }
+    let (mut text, mut quote, mut dynamic) = (vec![], None, false);
+    while let Some(&byte) = bytes.get(at) {
+        if quote == Some(b'\'') {
+            if byte == b'\'' {
+                quote = None;
+            } else {
+                text.push(byte);
+            }
+        } else if byte == b'\\' {
+            let Some(&next) = bytes.get(at + 1) else {
+                return (None, bytes.len());
+            };
+            if quote != Some(b'"') || b"$`\"\\\n".contains(&next) {
+                at += 1;
+                if next != b'\n' {
+                    text.push(next);
+                }
+            } else {
+                text.push(byte);
+            }
+        } else if quote == Some(b'"') {
+            if byte == b'"' {
+                quote = None;
+            } else {
+                dynamic |= matches!(byte, b'$' | b'`');
+                text.push(byte);
+            }
+        } else if matches!(byte, b'\'' | b'"') {
+            quote = Some(byte);
+        } else if byte.is_ascii_whitespace() || b";&|<>()".contains(&byte) {
+            break;
+        } else {
+            dynamic |= matches!(byte, b'$' | b'`' | b'*' | b'?' | b'[' | b'~');
+            text.push(byte);
+        }
+        at += 1;
+    }
+    let target = (!dynamic && quote.is_none() && !text.is_empty())
+        .then(|| String::from_utf8(text).ok())
+        .flatten();
+    (target, at)
+}
 pub fn quote(value: &str) -> String {
     format!("'{}'", value.replace('\'', "'\\''"))
 }
diff --git a/product/crates/ag1-core/tests/tool_contract.rs b/product/crates/ag1-core/tests/tool_contract.rs
index af5c3b6..b5823d4 100644
--- a/product/crates/ag1-core/tests/tool_contract.rs
+++ b/product/crates/ag1-core/tests/tool_contract.rs
@@ -1591,3 +1591,28 @@ fn path_expansion_preserves_sdk_home_prefix_and_unicode_space_semantics() {
     assert!(path::expand("@", Some("/fixture/home")).is_err());
     assert!(path::expand("nul\0path", None).is_err());
 }
+#[test]
+fn shell_write_hints_ignore_quoted_programs_and_escaped_operators() {
+    use ag1_core::tools::shell;
+
+    // A real P14 model check passed JavaScript to node -e. Its arrow belongs to
+    // the quoted program, and Bash does not create a file named "{".
+    for command in [
+        r#"node -e "(async () => { console.log('ok'); })()""#,
+        r#"node -e '(() => { console.log("ok"); })()'"#,
+        r#"printf '%s' 'value > imaginary.txt'"#,
+        r#"printf '%s' \> imaginary.txt"#,
+        r#"printf '%s' "escaped quote: \" > imaginary.txt""#,
+    ] {
+        assert!(shell::write_targets(command).is_empty(), "{command}");
+    }
+    // Quoted program text must not hide the real outer-shell destination.
+    assert_eq!(
+        shell::write_targets(r#"node -e "(() => { console.log('ok'); })()" > actual.txt"#),
+        ["actual.txt"]
+    );
+    assert_eq!(
+        shell::write_targets(r#"printf '%s' 'value > imaginary.txt' >> 'actual.txt'"#),
+        ["actual.txt"]
+    );
+}
