+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn repository_inspection_accepts_missing_optional_info_without_host_changes() {
+    for linked in [false, true] {
+        for missing in [vec!["info"], vec!["objects/info"], vec!["info", "objects/info"]] {
+            let fixture = fixture("http://127.0.0.1:1", "disabled");
+            let common_root = if linked {
+                let main = fixture._directory.path().join("main-repo");
+                std::fs::create_dir(&main).unwrap();
+                owned_repo_git(&main, &["init", "-b", "main"]);
+                owned_repo_git(&main, &["commit", "--allow-empty", "-m", "baseline"]);
+                owned_repo_git(&main, &["worktree", "add", "-b", "linked", fixture.root.to_str().unwrap()]);
+                main.join(".git")
+            } else {
+                owned_repo_git(&fixture.root, &["init", "-b", "main"]);
+                fixture.root.join(".git")
+            };
+            for name in &missing { std::fs::remove_dir_all(common_root.join(name)).unwrap(); }
+            owned_repo_git(&fixture.root, &["status", "--porcelain"]);
+            fn tree(root: &std::path::Path) -> std::collections::BTreeMap<std::path::PathBuf, Vec<u8>> {
+                let mut result = std::collections::BTreeMap::new();
+                for entry in std::fs::read_dir(root).unwrap() {
+                    let path = entry.unwrap().path();
+                    result.insert(path.clone(), if path.is_dir() { vec![] } else { std::fs::read(&path).unwrap() });
+                    if path.is_dir() { result.extend(tree(&path)); }
+                }
+                result
+            }
+            let before = tree(&common_root);
+            let runner = native_repo_runner(&fixture, "/usr/bin/git".as_ref()).await;
+            let result = execute_repo(&fixture, &runner, "optional-info", "status");
+            assert_ne!(result["isError"], true, "linked={linked}, missing={missing:?}: {result}");
+            assert_eq!(result["details"]["branch"], if linked { "linked" } else { "main" });
+            assert_eq!(tree(&common_root), before);
+            for name in &missing { assert!(!common_root.join(name).exists()); }
+        }
+    }
+}
