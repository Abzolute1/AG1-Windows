  "metadata": {
    "name": "task",
    "label": "task",
    "description": "Delegate a self-contained subtask to an isolated subagent with its own context and tools; receive only its final result.\n\nUse when a subtask would flood your context (multi-file exploration, log-heavy test runs) or benefits from isolation. Do not delegate a single path lookup, one file read, or one grep; use find/read/grep directly. The subagent sees ONLY your prompt — include everything it needs; it cannot ask questions or spawn subagents. Runs in the foreground; the result is the final summary plus capped evidence, never the transcript.",
    "parameters": {
      "type": "object",
      "required": [
        "description",
        "type",
        "prompt"
      ],
      "properties": {
        "description": {
          "description": "3-5 word task label shown in the UI",
          "type": "string"
        },
        "type": {
          "description": "Subagent profile: explore (read-only inspection, file:line evidence), research (explore + web, source URLs), implement (full tools, makes and verifies changes), verify (read-only + bash checks, reports commands + exit codes), plan (read-only, step-by-step plan)",
          "anyOf": [
            {
              "const": "explore",
              "type": "string"
            },
            {
              "const": "research",
              "type": "string"
            },
            {
              "const": "implement",
              "type": "string"
            },
            {
              "const": "verify",
              "type": "string"
            },
            {
              "const": "plan",
              "type": "string"
            }
          ]
        },
        "prompt": {
          "description": "Self-contained task brief. The subagent sees NOTHING else — no conversation, no context. Include file paths, goals, and constraints.",
          "type": "string"
        },
        "model": {
          "description": "Optional model override as provider/id. Default: routed by type (implement/plan use the current model; explore/research/verify may use a cheaper eligible model).",
          "type": "string"
        },
        "maxTurns": {
          "description": "Max assistant turns (default 12, hard cap 25)",
          "type": "number"
        },
        "timeout": {
          "description": "Wall-clock timeout in seconds (default 300)",
          "type": "number"
        },
        "resumeFrom": {
          "description": "Checkpoint ID from a previous failed run. The subagent resumes from where it left off, with prior findings injected as context.",
          "type": "string"
        }
      }
    },
    "promptSnippet": "Delegate a self-contained subtask to an isolated subagent (result-only return)",
    "promptGuidelines": [
      "Do not use task for a single path lookup, one file read, or one grep; use find/read/grep directly."
    ]
  },
