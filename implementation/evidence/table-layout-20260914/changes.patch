--- before/markdown.css
+++ after/markdown.css
@@ -1,4 +1,7 @@
 /* Shared message typography: keep nested list paragraphs together. */
+/* Keep table words in intrinsic sizing; wide tables use the existing scroll area. */
+.markdown.markdown table { overflow-wrap: normal; word-break: normal; }
+.markdown.markdown th, .markdown.markdown td { vertical-align: top; }
 .markdown.markdown { line-height: var(--chat-line-height, 1.6); }
 .markdown.markdown p { margin: 0 0 .7em; }
 .markdown.markdown ul, .markdown.markdown ol { margin: .45em 0 .8em; padding-left: 1.55em; }
