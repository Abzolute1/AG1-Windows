+/* Motion tuning surface: adjust these fallbacks or override the variables on
+   an ActivityStatus ancestor. The SVG shape itself is in ActivityMark.tsx.
+   Both animations use one cycle; no JS frame loop or polling is involved. */
+.ag1-activity-status {
+  display: flex;
+  align-items: center;
+  gap: var(--ag1-activity-gap, 9px);
+  min-height: 24px;
+  color: var(--muted-foreground);
+}
+.ag1-activity-mark {
+  width: var(--ag1-activity-size, 20px);
+  height: var(--ag1-activity-size, 20px);
+  flex: 0 0 var(--ag1-activity-size, 20px);
+  overflow: visible;
+  color: var(--foreground);
+}
+.ag1-activity-mark path {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: var(--ag1-activity-stroke, 2.2px);
+  stroke-linecap: round;
+  opacity: .35;
+  animation: ag1-stroke-breathe var(--ag1-activity-cycle, 2400ms) ease-in-out infinite;
+}
+.ag1-activity-mark g:nth-child(2) path { animation-delay: calc(var(--ag1-activity-cycle, 2400ms) / -3); }
+.ag1-activity-mark g:nth-child(3) path { animation-delay: calc(var(--ag1-activity-cycle, 2400ms) * -2 / 3); }
+@keyframes ag1-stroke-breathe {
+  0%, 65%, 100% { opacity: .35; transform: translateY(0); }
+  25% { opacity: 1; transform: translateY(var(--ag1-activity-travel, -.7px)); }
+}
+.ag1-activity-word { color: var(--muted-foreground); }
+@supports ((background-clip: text) or (-webkit-background-clip: text)) {
+  .ag1-activity-word {
+    background-image: linear-gradient(105deg, var(--muted-foreground) 35%, var(--foreground) 50%, var(--muted-foreground) 65%);
+    background-size: 250% 100%;
+    background-clip: text;
+    -webkit-background-clip: text;
+    -webkit-text-fill-color: transparent;
+    animation: ag1-word-shimmer var(--ag1-activity-cycle, 2400ms) linear infinite;
+  }
+}
+@keyframes ag1-word-shimmer {
+  0%, 12% { background-position: 150% 0; }
+  88%, 100% { background-position: -50% 0; }
+}
+.ag1-activity-mark[data-paused] path { animation: none; opacity: .7; }
+@media (prefers-reduced-motion: reduce), (forced-colors: active) {
+  .ag1-activity-mark path { animation: none; transform: none; opacity: .8; }
+  .ag1-activity-word { animation: none; background: none; -webkit-text-fill-color: currentColor; }
+}
