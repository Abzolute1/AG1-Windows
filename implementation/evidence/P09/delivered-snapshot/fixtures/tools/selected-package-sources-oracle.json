  "rows": [
    {
      "name": "DefaultPackageManager source parsing should parse package source types from docs examples",
      "calls": [
        {
          "method": "parse",
          "source": "npm:@scope/pkg@1.2.3",
          "output": {
            "type": "npm",
            "spec": "@scope/pkg@1.2.3",
            "name": "@scope/pkg",
            "pinned": true
          }
        },
        {
          "method": "parse",
          "source": "npm:pkg",
          "output": {
            "type": "npm",
            "spec": "pkg",
            "name": "pkg",
            "pinned": false
          }
        },
        {
          "method": "parse",
          "source": "git:github.com/user/repo@v1",
          "output": {
            "type": "git",
            "repo": "https://github.com/user/repo",
            "host": "github.com",
            "path": "user/repo",
            "ref": "v1",
            "pinned": true
          }
        },
        {
          "method": "parse",
          "source": "https://github.com/user/repo@v1",
          "output": {
            "type": "git",
            "repo": "https://github.com/user/repo",
            "host": "github.com",
            "path": "user/repo",
            "ref": "v1",
            "pinned": true
          }
        },
        {
          "method": "parse",
          "source": "git:git@github.com:user/repo@v1",
          "output": {
            "type": "git",
            "repo": "git@github.com:user/repo",
            "host": "github.com",
            "path": "user/repo",
            "ref": "v1",
            "pinned": true
          }
        },
        {
          "method": "parse",
          "source": "ssh://git@github.com/user/repo@v1",
          "output": {
            "type": "git",
            "repo": "ssh://git@github.com/user/repo",
            "host": "github.com",
            "path": "user/repo",
            "ref": "v1",
            "pinned": true
          }
        },
        {
          "method": "parse",
          "source": "/absolute/path/to/package",
          "output": {
            "type": "local",
            "path": "/absolute/path/to/package"
          }
        },
        {
          "method": "parse",
          "source": "./relative/path/to/package",
          "output": {
            "type": "local",
            "path": "./relative/path/to/package"
          }
        },
        {
          "method": "parse",
          "source": "../relative/path/to/package",
          "output": {
            "type": "local",
            "path": "../relative/path/to/package"
          }
        }
      ],
      "assertions": 9
    },
