+static void ggml_compute_forward_mul_mat_id_single_token(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+
+    const enum ggml_type dot_type = type_traits_cpu[src0->type].vec_dot_type;
+    ggml_vec_dot_t const vec_dot = type_traits_cpu[src0->type].vec_dot;
+    const size_t row_size = ggml_row_size(dot_type, src1->ne[0]);
+    const bool contiguous_input = ggml_is_contiguous(src1) || src1->type != dot_type;
+    const char * wdata = src1->type == dot_type ? src1->data : params->wdata;
+
+    const int64_t blocks_per_slot = (src0->ne[1] + 15) / 16;
+    const int64_t total_blocks = ids->ne[0] * blocks_per_slot;
+    const int64_t first = total_blocks * params->ith / params->nth;
+    const int64_t last  = total_blocks * (params->ith + 1) / params->nth;
+    float tmp[16];
+
+    for (int64_t block = first; block < last; ++block) {
+        const int64_t slot = block / blocks_per_slot;
+        const int64_t row = (block % blocks_per_slot) * 16;
+        const int64_t end = MIN(row + 16, src0->ne[1]);
+        const int32_t expert = *(const int32_t *) ((const char *) ids->data + slot * ids->nb[0]);
+        GGML_ASSERT(expert >= 0 && expert < src0->ne[2]);
+        const int64_t input_slot = slot % src1->ne[1];
+        const char * weights = (const char *) src0->data + expert * src0->nb[2];
+        const char * activation = wdata + input_slot * (contiguous_input ? row_size : src1->nb[1]);
+        float * output = (float *) ((char *) dst->data + slot * dst->nb[1]);
+        for (int64_t r = row; r < end; ++r) {
+            vec_dot(src0->ne[0], &tmp[r - row], 0, weights + r * src0->nb[1], 0, activation, 0, 1);
+        }
+        memcpy(output + row, tmp, (end - row) * sizeof(float));
+    }
+}
