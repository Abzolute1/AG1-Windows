+    std::vector<std::pair<uintptr_t, uintptr_t>> register_ranges;
+#ifdef __linux__
+    if (ml.use_mmap && std::getenv("AG1_FLASH_REGISTER_MMAP")) {
+        const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+        for (const auto & [ctx, buffers] : ctx_buf_maps) {
+            bool lazy = false;
+            for (ggml_tensor * tensor = ggml_get_first_tensor(ctx); tensor; tensor = ggml_get_next_tensor(ctx, tensor)) {
+                // Lazy PLE must remain pageable: its 35.8 GiB table cannot be pinned.
+                if (std::string(tensor->name).find("per_layer_token_embd") != std::string::npos) {
+                    lazy = true;
+                    break;
+                }
+            }
+            if (lazy) continue;
+            for (const auto & [idx, runs] : buffers) {
+                (void) idx;
+                for (ggml_backend_buffer_t buffer : runs) {
+                    if (!ggml_backend_buffer_is_host(buffer)) continue;
+                    const uintptr_t begin = (uintptr_t) ggml_backend_buffer_get_base(buffer);
+                    const uintptr_t end = begin + ggml_backend_buffer_get_size(buffer);
+                    if (end > begin) register_ranges.emplace_back(begin & ~(page - 1), (end + page - 1) & ~(page - 1));
+                }
+            }
+        }
+    }
+#endif
+
     // load tensor data
     for (auto & [ctx, buf_map] : ctx_buf_maps) {
         if (!ml.load_all_data(ctx, buf_map, use_mlock ? &pimpl->mlock_mmaps : NULL, params.progress_callback, params.progress_callback_user_data)) {
             return false;
+        }
+    }
+
+    if (!register_ranges.empty()) {
+        auto reg = ggml_backend_reg_by_name("CUDA");
+        auto register_host = reg ? reinterpret_cast<bool (*)(void *, size_t)>(
+                ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_buffer")) : nullptr;
+        auto unregister_host = reg ? reinterpret_cast<void (*)(void *)>(
+                ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_buffer")) : nullptr;
+        if (register_host && unregister_host) {
+            std::sort(register_ranges.begin(), register_ranges.end());
+            std::vector<std::pair<uintptr_t, uintptr_t>> merged;
+            for (const auto & range : register_ranges) {
+                if (!merged.empty() && range.first <= merged.back().second) {
+                    merged.back().second = std::max(merged.back().second, range.second);
+                } else {
+                    merged.push_back(range);
+                }
+            }
+            size_t total = 0;
+            const int64_t begin_us = ggml_time_us();
+            for (const auto & [first, last] : merged) {
+                if (register_host((void *) first, last - first)) {
+                    pimpl->registered_host.push_back((void *) first);
+                    total += last - first;
+                } else {
+                    LLAMA_LOG_WARN("%s: host registration failed for %.2f MiB\n", __func__, (last - first) / 1048576.0);
+                }
+            }
+            pimpl->unregister_host = unregister_host;
+            LLAMA_LOG_INFO("%s: registered %.2f MiB mapped host weights in %.3f s (%zu ranges)\n",
