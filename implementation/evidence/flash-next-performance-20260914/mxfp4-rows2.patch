+        const __m256i y0=_mm256_loadu_si256((const __m256i *)y[i].qs);
+        const __m256i y1=_mm256_loadu_si256((const __m256i *)y[i+1].qs);
+        const float d0=GGML_CPU_FP16_TO_FP32(y[i].d),d1=GGML_CPU_FP16_TO_FP32(y[i+1].d);
