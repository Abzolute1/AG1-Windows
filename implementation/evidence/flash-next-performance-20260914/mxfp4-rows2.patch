+        AG1_MX_ACC(x0,i+1,y1,d1,a01);
+        AG1_MX_ACC(x1,i+1,y1,d1,a11);
+#undef AG1_MX_ACC
+    }
+    s[0]=hsum_float_8(_mm256_add_ps(a00,a01));
+    s[1]=hsum_float_8(_mm256_add_ps(a10,a11));
+#else
+    for (int row=0;row<2;++row) ggml_vec_dot_mxfp4_q8_0(n,s+row,0,(const char *)vx+row*row_stride,0,vy,0,1);
+#endif
 }
 
