+    fn checked_extension(&self, values: &[Value]) -> Option<Self> {
+        if values.len() < self.len {
+            return None;
+        }
+        // Reproduce serde's complete array bytes while retaining the hash state
+        // just before its closing bracket. Verify the entire old prefix, then
+        // extend that same pass with the appended values for the next witness.
+        let mut hash = Sha256::new();
+        hash.update(b"[");
+        for (index, value) in values[..self.len].iter().enumerate() {
+            if index != 0 {
+                hash.update(b",");
+            }
+            serde_json::to_writer(&mut hash, value).expect("JSON values serialize to a digest");
+        }
+        let mut previous = hash.clone();
+        previous.update(b"]");
+        if <[u8; 32]>::from(previous.finalize()) != self.digest {
+            return None;
+        }
+        for (index, value) in values[self.len..].iter().enumerate() {
+            if self.len + index != 0 {
+                hash.update(b",");
+            }
+            serde_json::to_writer(&mut hash, value).expect("JSON values serialize to a digest");
+        }
+        hash.update(b"]");
+        Some(Self {
+            len: values.len(),
+            digest: hash.finalize().into(),
+        })
+    }
+}
