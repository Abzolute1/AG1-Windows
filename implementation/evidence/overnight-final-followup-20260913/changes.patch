+/// The validated inputs remain immutably borrowed until the prospective cache is
+/// built. A caller cannot change them after verification and reuse their hashes.
+/// Final admission still independently checks owner/revision and source freshness.
+pub(super) struct Continuation<'a> {
+    stamp: &'a Stamp,
+    key: &'a Value,
+    branch: &'a [Value],
+    original: &'a [Value],
+    branch_identity: Prefix,
+    original_identity: Prefix,
+    messages: Vec<Value>,
+}
+impl Continuation<'_> {
+    pub(super) fn messages(&self) -> &[Value] {
+        &self.messages
+    }
+    pub(super) fn finish(self, compiled: Vec<Value>, request: RequestIdentity) -> WorkingSet {
+        debug_assert_eq!(self.branch.len(), self.branch_identity.len);
+        debug_assert_eq!(self.original.len(), self.original_identity.len);
+        WorkingSet {
+            stamp: self.stamp.clone(),
+            key: self.key.clone(),
+            branch: self.branch_identity,
+            original: self.original_identity,
+            compiled: Arc::new(compiled),
+            request,
+        }
     }
 }
 
