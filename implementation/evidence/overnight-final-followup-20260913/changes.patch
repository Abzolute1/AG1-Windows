+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ag1_core::{SessionId, runtime::boundary::Boundary};
+    #[test]
+    fn checked_extension_matches_whole_array_hash_and_rejects_changed_prefixes() {
+        let rows = vec![
+            json!({"text":"β\n\"","nested":[null,true,1.25],"id":"a"}),
+            json!({"id":"b","parent":"a"}),
+            json!({"role":"user","content":"new turn"}),
+        ];
+        for length in 0..=rows.len() {
+            let prefix = Prefix::of(&rows[..length]);
+            let next = prefix.checked_extension(&rows).unwrap();
+            assert_eq!(next.len, rows.len());
+            assert_eq!(next.digest, Prefix::of(&rows).digest);
+            assert_eq!(
+                prefix.checked_extension(&rows[..length]).unwrap().digest,
+                prefix.digest
+            );
+            if length != 0 {
+                assert!(prefix.checked_extension(&rows[..length - 1]).is_none());
+                let mut edited = rows.clone();
+                edited[0]["id"] = json!("replacement");
+                assert!(prefix.checked_extension(&edited).is_none());
+            }
+        }
+    }
+    #[test]
+    fn continuation_keeps_owner_configuration_and_branch_fences_across_publication() {
+        let mut owner = Boundary::new(SessionId::new("session").unwrap(), 1).unwrap();
+        let other = Boundary::new(SessionId::new("session").unwrap(), 1).unwrap();
+        let key = json!({"model":"same","tools":["read"]});
+        let branch = vec![json!({"id":"a","parent":null,"message":"first"})];
+        let original = vec![json!({"role":"user","content":"first"})];
+        let identity = || RequestIdentity::new(&key, &original);
+        let cache = WorkingSet::new(
+            owner.stamp().clone(),
+            key.clone(),
+            &branch,
+            &original,
+            original.clone(),
+            identity(),
+        );
+        assert!(
+            cache
+                .extend(other.stamp(), &key, &branch, &original)
+                .is_none()
+        );
+        assert!(
+            cache
+                .extend(
+                    owner.stamp(),
+                    &json!({"model":"different"}),
+                    &branch,
+                    &original
+                )
+                .is_none()
+        );
+        let mut changed_branch = branch.clone();
+        changed_branch[0]["parent"] = json!("other");
+        assert!(
+            cache
+                .extend(owner.stamp(), &key, &changed_branch, &original)
+                .is_none()
+        );
+        let mut changed_original = original.clone();
+        changed_original[0]["content"] = json!("changed");
+        assert!(
+            cache
+                .extend(owner.stamp(), &key, &branch, &changed_original)
+                .is_none()
+        );
+        owner.changed().unwrap();
+        let mut appended = original.clone();
+        appended.push(json!({"role":"assistant","content":"reply"}));
+        let next = cache
+            .extend(owner.stamp(), &key, &branch, &appended)
+            .unwrap();
+        assert_eq!(next.messages(), appended);
+        let compiled = next.messages().to_vec();
+        let next = next.finish(compiled, identity());
+        assert!(
+            next.extend(owner.stamp(), &key, &branch, &appended)
+                .is_some()
+        );
+        assert!(
+            next.extend(owner.stamp(), &key, &branch, &original)
+                .is_none()
+        );
+    }
+}
