{
  "result": {
    "tools": [
      {
        "name": "you-search",
        "title": "Web Search",
        "description": "Search the web for current information, facts, news, and sources.\n>\nBest for: current events, facts about people, companies, and organizations, finding primary sources, verifying claims.\nReturns: ranked results with URLs and snippets \u2014 read them with you-contents before answering; snippets are not page content.\n>\nQuery tips:\n- One intent per search, phrased naturally: \"tariff exemptions for semiconductor imports 2026\" \u2014 not a question, not a pile of synonyms.\n- Inline filters are mapped automatically: `site:cdc.gov`, `lang:fr`, `loc:DE`.\n- On zero results, don't repeat the query: widen it, drop filters, or read the best prior result with you-contents.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Short natural-language phrase describing one thing to find, e.g. \"tariff exemptions for semiconductor imports 2026\". Inline `site:`, `lang:`, `loc:` filters are mapped automatically."
            },
            "count": {
              "default": 30,
              "description": "Max results per section",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "freshness": {
              "description": "Limit results to a recent window. Use it when recency matters \u2014 news, prices, releases, \"this year\" \u2014 and omit it for evergreen facts. Pass a named bucket (`day`, `week`, `month`, `year`) or a date range `YYYY-MM-DDtoYYYY-MM-DD`. If the query already names a timeframe, the broader of the two wins, so this can only widen, never narrow, the query phrase.",
              "type": "string"
            },
            "extraction": {
              "default": "highlights",
              "description": "Extraction mode. \"highlights\" (default) returns query-relevant passages; \"none\" returns plain snippets; \"full_page\" crawls each result and returns full page content.",
              "type": "string",
              "enum": [
                "none",
                "highlights",
                "full_page"
              ]
            },
            "knowledge": {
              "description": "Include licensed knowledge results relevant to the query. core requests factual answers alongside web and news results; matching results appear in results.knowledge.",
              "type": "string",
              "enum": [
                "core"
              ]
            },
            "extraction_source": {
              "description": "Where full-page content comes from when extraction is 'full_page'. 'cache' is included in base cost, 'fetch' bills at livecrawl rates, 'blend' bills only for pages not in cache.",
              "type": "string",
              "enum": [
                "cache",
                "fetch",
                "blend"
              ]
            }
          },
          "required": [
            "query"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        },
        "_meta": {
          "co.baseten/llm-controllable-params-default": [
            "query",
            "freshness"
          ]
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "results": {
              "type": "object",
              "properties": {
                "web": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "description": "URL of the search result",
                        "type": "string"
                      },
                      "title": {
                        "description": "Title of the search result",
                        "type": "string"
                      },
                      "description": {
                        "description": "Short description of the search result",
                        "type": "string"
                      },
                      "snippets": {
                        "description": "Query-relevant text excerpts from the page",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "page_age": {
                        "description": "Publication date of the page",
                        "type": "string"
                      },
                      "thumbnail_url": {
                        "description": "Thumbnail image URL",
                        "type": "string"
                      },
                      "favicon_url": {
                        "description": "Favicon URL",
                        "type": "string"
                      },
                      "contents": {
                        "description": "Extracted page content",
                        "type": "object",
                        "properties": {
                          "html": {
                            "description": "Full HTML content",
                            "type": "string"
                          },
                          "markdown": {
                            "description": "Full Markdown content",
                            "type": "string"
                          },
                          "highlights": {
                            "description": "Query-relevant passages from the page",
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "news": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "description": "Title of the news result",
                        "type": "string"
                      },
                      "description": {
                        "description": "Short description of the news result",
                        "type": "string"
                      },
                      "page_age": {
                        "description": "Publication date of the article",
                        "type": "string"
                      },
                      "url": {
                        "description": "URL of the news result",
                        "type": "string"
                      },
                      "thumbnail_url": {
                        "description": "Thumbnail image URL",
                        "type": "string"
                      },
                      "contents": {
                        "description": "Extracted page content",
                        "type": "object",
                        "properties": {
                          "html": {
                            "description": "Full HTML content",
                            "type": "string"
                          },
                          "markdown": {
                            "description": "Full Markdown content",
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "knowledge": {
                  "description": "Knowledge results backed by licensed data providers.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "The kind of knowledge result retrieved."
                      },
                      "title": {
                        "type": "string",
                        "description": "The title of the knowledge result."
                      },
                      "attribution": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Data provider for the knowledge result."
                            },
                            "source_description": {
                              "description": "Description of the provider.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "name"
                          ],
                          "additionalProperties": false
                        },
                        "description": "Display credit for the data behind the result."
                      },
                      "description": {
                        "description": "Description of the knowledge result.",
                        "type": "string"
                      },
                      "as_of": {
                        "description": "The date the result's underlying data covers, as YYYY-MM-DD.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "title",
                      "attribution"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "metadata": {
              "type": "object",
              "properties": {
                "search_uuid": {
                  "description": "Unique search request ID",
                  "type": "string"
                },
                "query": {
                  "description": "The search query that was submitted",
                  "type": "string"
                },
                "latency": {
                  "description": "Search latency in seconds",
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "results",
            "metadata"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "you-discover",
        "title": "Agent Discovery",
        "description": "Discover AI agents, MCP servers, A2A agents, and skills via ARD Agent Finder services. Search-only \u2014 never installs or connects. Returns ranked results with relevance scores.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Natural-language task to find agents/tools for."
            },
            "finder": {
              "default": "all",
              "description": "Which Agent Finder discovery service(s) to query.",
              "type": "string",
              "enum": [
                "github",
                "huggingface",
                "all"
              ]
            },
            "limit": {
              "default": 10,
              "description": "Max consolidated results (1\u201325).",
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            },
            "finder_url": {
              "description": "Optional custom finder URL (must be public http/https). Augments selected finders.",
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "query"
          ]
        },
        "annotations": {
          "readOnlyHint": true
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "The original discovery query"
            },
            "finders": {
              "type": "object",
              "properties": {
                "queried": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Finder services that were queried"
                },
                "responded": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Finder services that returned results"
                },
                "failed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Finder services that failed to respond"
                }
              },
              "required": [
                "queried",
                "responded",
                "failed"
              ],
              "additionalProperties": false,
              "description": "Per-finder request status"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string",
                    "description": "Stable URN identifier for the discovered resource"
                  },
                  "displayName": {
                    "type": "string",
                    "description": "Human-readable name of the resource"
                  },
                  "type": {
                    "type": "string",
                    "description": "Raw ARD resource MIME type (e.g. application/mcp-server+json, application/a2a-agent-card+json, application/ai-skill)"
                  },
                  "resourceKind": {
                    "type": "string",
                    "enum": [
                      "mcp-server",
                      "a2a-agent",
                      "skill",
                      "api",
                      "raw"
                    ],
                    "description": "Normalized resource kind for filtering/display (mcp-server, a2a-agent, skill, api, raw)"
                  },
                  "url": {
                    "type": "string",
                    "description": "URL to access or install the resource"
                  },
                  "score": {
                    "type": "number",
                    "description": "Finder-provided relevance score, higher is better; not a trust, quality, or safety rating"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Finder base URLs that returned this result"
                  },
                  "description": {
                    "description": "Short description of the resource",
                    "type": "string"
                  },
                  "publisher": {
                    "description": "Publisher domain parsed from the identifier",
                    "type": "string"
                  }
                },
                "required": [
                  "identifier",
                  "displayName",
                  "type",
                  "resourceKind",
                  "url",
                  "score",
                  "sources"
                ],
                "additionalProperties": false
              },
              "description": "Ranked consolidated results, highest score first"
            },
            "referrals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "identifier",
                  "type",
                  "url"
                ],
                "additionalProperties": {}
              },
              "description": "Informational referrals to non-result resources"
            }
          },
          "required": [
            "query",
            "finders",
            "results",
            "referrals"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "jsonrpc": "2.0",
  "id": 2
}
