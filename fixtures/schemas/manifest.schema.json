{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AG1 reference capability manifest",
  "type": "object",
  "required": [
    "version",
    "source_commit",
    "capabilities",
    "captured_files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 85,
      "maxItems": 85,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_owner",
          "risk",
          "reference_tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "reference_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "captured_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
