{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized AgentSession capture",
  "type": "object",
  "required": [
    "version",
    "scenarios",
    "modelActions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "modelActions": {
      "const": 0
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "inputs",
          "requests",
          "events",
          "canonicalMessages",
          "journal",
          "assertions",
          "normalization"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "requests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "systemPrompt",
                "messages",
                "tools"
              ]
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          },
          "canonicalMessages": {
            "type": "array"
          },
          "journal": {
            "type": "array"
          },
          "assertions": {
            "type": "object"
          },
          "normalization": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
