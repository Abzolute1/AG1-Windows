    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "expected_revision": {
          "$ref": "#/$defs/Sequence"
        },
        "extension": true,
        "id": {
          "$ref": "#/$defs/CommandId"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "scope",
        "expected_revision",
        "command"
      ]
    },
    "CommandId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "CommandResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
