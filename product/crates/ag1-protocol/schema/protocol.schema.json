  "$defs": {
    "ApprovalBinding": {
      "type": "object",
      "properties": {
        "argument_sha256": {
          "type": "string"
        },
        "expires_ms": {
          "$ref": "#/$defs/Sequence"
        },
        "id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "operation": {
          "$ref": "#/$defs/OperationId"
        },
        "revision": {
          "$ref": "#/$defs/Sequence"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "argument_sha256",
        "scope",
        "revision",
        "expires_ms"
      ]
    },
    "ApprovalId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "ArtifactId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "BranchId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "BridgeFrame": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "snapshot"
            },
            "snapshot": {
              "$ref": "#/$defs/BridgeSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "snapshot"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": true,
            "durable": {
              "type": "boolean"
            },
            "id": {
              "$ref": "#/$defs/CommandId"
            },
            "kind": {
              "type": "string",
              "const": "reply"
            },
            "revision": {
              "$ref": "#/$defs/Sequence"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            },
            "status": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "scope",
            "revision",
            "durable",
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "progress"
            },
            "operation": {
              "$ref": "#/$defs/OperationId"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "operation",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "detail": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "fatal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "detail"
          ]
        }
      ]
    },
    "BridgeMessage": {
      "description": "P04 real SDK projections. Full payloads stay in TS-owned evidence; views are bounded.",
      "type": "object",
      "properties": {
        "evidence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "text",
        "evidence"
      ]
    },
    "BridgeQuestion": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/ApprovalBinding"
        },
        "evidence": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "title",
        "kind",
        "options",
        "evidence",
        "truncated"
      ]
    },
    "BridgeSnapshot": {
      "type": "object",
      "properties": {
        "active_operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixture_provider": {
          "type": "boolean"
        },
        "message_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BridgeMessage"
          }
        },
        "model": {
          "type": "string"
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BridgeQuestion"
          }
        },
        "revision": {
          "$ref": "#/$defs/Sequence"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "watermark": {
          "$ref": "#/$defs/Sequence"
        },
        "workspace_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "revision",
        "watermark",
        "workspace_path",
        "status",
        "messages",
        "message_count",
        "pending",
        "model",
        "fixture_provider"
      ]
    },
    "ClientDetails": {
      "type": "object",
      "properties": {
        "activity": true,
        "artifacts": {
          "type": "array",
          "items": true
        },
        "authority": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": true,
        "memory": true,
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientMessage"
          }
        },
        "models": {
          "type": "array",
          "items": true
        },
        "task": true
      },
      "additionalProperties": false,
      "required": [
        "authority",
        "messages",
        "task",
        "context",
        "artifacts",
        "memory",
        "activity",
        "models",
        "capabilities"
      ]
    },
    "ClientMessage": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageBlock"
          }
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "blocks"
      ]
    },
    "ClientView": {
      "type": "object",
      "properties": {
        "details": {
          "$ref": "#/$defs/ClientDetails"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/BridgeSnapshot"
        }
      },
      "additionalProperties": false,
      "required": [
        "snapshot",
        "progress",
        "details"
      ]
    },
    "Command": {
