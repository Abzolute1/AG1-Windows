          "$ref": "#/$defs/Sequence"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sequence": {
          "$ref": "#/$defs/Sequence"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "sequence",
        "revision",
        "operation"
      ]
    },
    "Handshake": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fake": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "$ref": "#/$defs/Version"
