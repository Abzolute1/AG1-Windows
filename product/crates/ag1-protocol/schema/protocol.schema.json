            "kind": {
              "type": "string",
              "const": "cancel"
            },
            "operation": {
              "$ref": "#/$defs/OperationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "operation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "binding": {
              "$ref": "#/$defs/ApprovalBinding"
            },
            "kind": {
              "type": "string",
              "const": "approve"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "binding",
            "allow"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "$ref": "#/$defs/CommandId"
            },
            "kind": {
              "type": "string",
              "const": "command_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "type": "string",
              "const": "artifact_read"
            },
            "limit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "offset": {
              "$ref": "#/$defs/Sequence"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact",
            "offset",
            "limit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "session"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "task"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "plan"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "files"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "artifacts"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "memory"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "model"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "runtime"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "args": true,
            "kind": {
              "type": "string",
              "const": "diagnostics"
