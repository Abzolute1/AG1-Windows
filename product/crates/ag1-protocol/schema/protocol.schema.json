{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireMessage",
  "description": "Root includes every boundary type so generated dependencies cannot silently go missing.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Handshake"
        },
        "type": {
          "type": "string",
          "const": "handshake"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/CommandEnvelope"
        },
        "type": {
          "type": "string",
          "const": "command"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Reply"
        },
        "type": {
          "type": "string",
          "const": "result"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Snapshot"
        },
        "type": {
          "type": "string",
          "const": "snapshot"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Delivery"
        },
        "type": {
          "type": "string",
          "const": "delivery"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Subscription"
        },
        "type": {
          "type": "string",
          "const": "subscription"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Cursor"
        },
        "type": {
          "type": "string",
          "const": "cursor"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ProtocolError"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/BridgeFrame"
        },
        "type": {
          "type": "string",
          "const": "bridge"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ClientView"
        },
        "type": {
          "type": "string",
          "const": "client"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ]
    }
