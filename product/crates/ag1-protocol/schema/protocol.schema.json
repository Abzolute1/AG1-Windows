            "operation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settled"
            },
            "operation": {
              "$ref": "#/$defs/OperationView"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "operation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactId"
            },
            "base64": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "artifact_page"
            },
            "next": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sequence"
                },
                {
                  "type": "null"
                }
              ]
            },
            "offset": {
              "$ref": "#/$defs/Sequence"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact",
            "offset",
            "base64",
            "next"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ProtocolError"
            },
            "kind": {
              "type": "string",
              "const": "rejected"
